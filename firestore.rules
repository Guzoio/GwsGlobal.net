rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all para todas as outras coleções não mapeadas
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLicitacao(data) {
      return data.keys().hasAll(['id', 'orgao', 'processo_pregao', 'modalidade', 'data_cadastro', 'responsavel'])
        && data.id is number
        && data.orgao is string && data.orgao.size() <= 500
        && data.processo_pregao is string && data.processo_pregao.size() <= 200
        && data.modalidade is string && data.modalidade.size() <= 100
        && data.data_cadastro is string && data.data_cadastro.size() <= 50
        && data.responsavel is string && data.responsavel.size() <= 150;
    }

    function isValidItem(data) {
      return data.keys().hasAll(['id', 'licitacao_id', 'num_item', 'descricao_curta', 'marca', 'quantidade', 'valor_unitario'])
        && data.id is number
        && data.licitacao_id is number
        && data.num_item is number
        && data.descricao_curta is string && data.descricao_curta.size() <= 500
        && data.marca is string && data.marca.size() <= 200
        && data.quantidade is number
        && data.valor_unitario is number;
    }

    function isValidTimbrado(data) {
      return data.keys().hasAll(['razaoSocial', 'cnpj', 'nomeRepresentante'])
        && data.razaoSocial is string && data.razaoSocial.size() <= 300
        && data.cnpj is string && data.cnpj.size() <= 50
        && data.nomeRepresentante is string && data.nomeRepresentante.size() <= 200;
    }

    function isValidResponsaveis(data) {
      return data.keys().hasAll(['nomes'])
        && data.nomes is string && data.nomes.size() <= 2000;
    }

    function isValidSeguranca(data) {
      return data.usuarioId is string && data.usuarioId.size() <= 100
        && (
          (data.keys().hasAll(['usuarioId', 'senhaHash']) && data.senhaHash is string && data.senhaHash.size() <= 150) ||
          (data.keys().hasAll(['usuarioId', 'senha']) && data.senha is string && data.senha.size() <= 150)
        );
    }

    // Licitações Collection - Sincronização em tempo real da equipe
    match /licitacoes/{licitacaoId} {
      allow read: if true;
      allow create: if isValidId(licitacaoId) && isValidLicitacao(incoming());
      allow update: if isValidId(licitacaoId) && isValidLicitacao(incoming());
      allow delete: if isValidId(licitacaoId);
    }

    // Itens de Licitação Collection
    match /itens/{itemId} {
      allow read: if true;
      allow create: if isValidId(itemId) && isValidItem(incoming());
      allow update: if isValidId(itemId) && isValidItem(incoming());
      allow delete: if isValidId(itemId);
    }

    // Configurações Documentos
    match /configuracoes/papel_timbrado {
      allow read: if true;
      allow create, update: if isValidTimbrado(incoming());
      allow delete: if false;
    }

    match /configuracoes/lista_responsaveis {
      allow read: if true;
      allow create, update: if isValidResponsaveis(incoming());
      allow delete: if false;
    }

    match /configuracoes/seguranca {
      allow read: if true;
      allow create, update: if isValidSeguranca(incoming());
      allow delete: if false;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }
  }
}
